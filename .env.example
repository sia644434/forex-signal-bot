# =========================
# Telegram
# =========================
TELEGRAM_BOT_TOKEN=

# =========================
# Market Data APIs
# =========================
OANDA_API_KEY=
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=

# =========================
# AI
# =========================
AI_ENABLED=false
AI_API_KEY=
AI_MODEL=gpt-5.6-luna
AI_TEMPERATURE=0.2

# =========================
# Trading Defaults
# =========================
DEFAULT_SYMBOL=EURUSD
DEFAULT_TIMEFRAME=1h
ACCOUNT_CURRENCY=
ACCOUNT_BALANCE=1000
RISK_PER_TRADE=0.01
MAX_OPEN_POSITIONS=5

# Position sizing uses ACCOUNT_BALANCE and RISK_PER_TRADE explicitly.
# Cross-currency instruments also require an explicit quote-to-account FX rate
# at the RiskEngine call boundary; no implicit USD assumption is used.

# =========================
# Network
# =========================
REQUEST_TIMEOUT=30
MAX_RETRIES=3

# =========================
# Application
# =========================
APP_NAME=Professional Trading Bot
LOG_LEVEL=INFO
ENVIRONMENT=production
DEBUG=false
TIMEZONE=UTC
